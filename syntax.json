{
  "webly": {
    "name": "Webly",
    "version": "1.0",
    "description": "Webly syntax mapped to native HTML, CSS, and JavaScript.",

    "page": {
      "properties": {
        "background": {
          "type": "property",
          "target": "page",
          "webly": "{target}.background = {value}",
          "original": "document.body.style.background = {value};"
        },
        "color": {
          "type": "property",
          "target": "page",
          "webly": "{target}.color = {value}",
          "original": "document.body.style.color = {value};"
        },
        "title": {
          "type": "property",
          "target": "page",
          "webly": "{target}.title = {value}",
          "original": "document.title = {value};"
        },
        "width": {
          "type": "property",
          "target": "page",
          "webly": "{target}.width = {value}",
          "original": "document.body.style.width = {value};"
        },
        "height": {
          "type": "property",
          "target": "page",
          "webly": "{target}.height = {value}",
          "original": "document.body.style.height = {value};"
        }
      }
    },

    "html": {
      "elements": {
        "button": {
          "create": {
            "type": "element",
            "tag": "button",
            "webly": "{type}.create({name})",
            "original": "<button id={name}></button>"
          }
        },

        "label": {
          "create": {
            "type": "element",
            "tag": "label",
            "webly": "{type}.create({name})",
            "original": "<label id={name}></label>"
          }
        },

        "input": {
          "create": {
            "type": "element",
            "tag": "input",
            "webly": "{type}.create({name})",
            "original": "<input id={name}>"
          }
        },

        "text": {
          "create": {
            "type": "element",
            "tag": "span",
            "webly": "{type}.create({name})",
            "original": "<span id={name}></span>"
          }
        },

        "box": {
          "create": {
            "type": "element",
            "tag": "div",
            "webly": "{type}.create({name})",
            "original": "<div id={name}></div>"
          }
        },

        "image": {
          "create": {
            "type": "element",
            "tag": "img",
            "webly": "{type}.create({name})",
            "original": "<img id={name}>"
          }
        },

        "link": {
          "create": {
            "type": "element",
            "tag": "a",
            "webly": "{type}.create({name})",
            "original": "<a id={name}></a>"
          }
        },

        "heading": {
          "create": {
            "type": "element",
            "tag": "h1",
            "webly": "{type}.create({name})",
            "original": "<h1 id={name}></h1>"
          }
        }
      },

      "properties": {
        "text": {
          "type": "property",
          "webly": "{element}.text = {value}",
          "original": "document.getElementById({element}).textContent = {value};"
        },

        "html": {
          "type": "property",
          "webly": "{element}.html = {value}",
          "original": "document.getElementById({element}).innerHTML = {value};"
        },

        "value": {
          "type": "property",
          "webly": "{element}.value = {value}",
          "original": "document.getElementById({element}).value = {value};"
        },

        "src": {
          "type": "property",
          "webly": "{element}.src = {value}",
          "original": "document.getElementById({element}).src = {value};"
        },

        "href": {
          "type": "property",
          "webly": "{element}.href = {value}",
          "original": "document.getElementById({element}).href = {value};"
        }
      }
    },

    "css": {
      "properties": {
        "color": {
          "type": "style",
          "property": "color",
          "webly": "{element}.color = {value}",
          "original": "#{element} { color: {value}; }"
        },

        "background": {
          "type": "style",
          "property": "background",
          "webly": "{element}.background = {value}",
          "original": "#{element} { background: {value}; }"
        },

        "width": {
          "type": "style",
          "property": "width",
          "unit": "px",
          "webly": "{element}.width = {value}",
          "original": "#{element} { width: {value}px; }"
        },

        "height": {
          "type": "style",
          "property": "height",
          "unit": "px",
          "webly": "{element}.height = {value}",
          "original": "#{element} { height: {value}px; }"
        },

        "radius": {
          "type": "style",
          "property": "borderRadius",
          "unit": "px",
          "webly": "{element}.radius = {value}",
          "original": "#{element} { border-radius: {value}px; }"
        },

        "fontSize": {
          "type": "style",
          "property": "fontSize",
          "unit": "px",
          "webly": "{element}.fontSize = {value}",
          "original": "#{element} { font-size: {value}px; }"
        },

        "padding": {
          "type": "style",
          "property": "padding",
          "unit": "px",
          "webly": "{element}.padding = {value}",
          "original": "#{element} { padding: {value}px; }"
        },

        "margin": {
          "type": "style",
          "property": "margin",
          "unit": "px",
          "webly": "{element}.margin = {value}",
          "original": "#{element} { margin: {value}px; }"
        },

        "display": {
          "type": "style",
          "property": "display",
          "webly": "{element}.display = {value}",
          "original": "#{element} { display: {value}; }"
        },

        "direction": {
          "type": "style",
          "property": "flexDirection",
          "webly": "{element}.direction = {value}",
          "original": "#{element} { flex-direction: {value}; }"
        },

        "align": {
          "type": "style",
          "property": "alignItems",
          "webly": "{element}.align = {value}",
          "original": "#{element} { align-items: {value}; }"
        },

        "justify": {
          "type": "style",
          "property": "justifyContent",
          "webly": "{element}.justify = {value}",
          "original": "#{element} { justify-content: {value}; }"
        },

        "gap": {
          "type": "style",
          "property": "gap",
          "unit": "px",
          "webly": "{element}.gap = {value}",
          "original": "#{element} { gap: {value}px; }"
        },

        "position": {
          "type": "style",
          "property": "position",
          "webly": "{element}.position = {value}",
          "original": "#{element} { position: {value}; }"
        },

        "top": {
          "type": "style",
          "property": "top",
          "unit": "px",
          "webly": "{element}.top = {value}",
          "original": "#{element} { top: {value}px; }"
        },

        "left": {
          "type": "style",
          "property": "left",
          "unit": "px",
          "webly": "{element}.left = {value}",
          "original": "#{element} { left: {value}px; }"
        },

        "right": {
          "type": "style",
          "property": "right",
          "unit": "px",
          "webly": "{element}.right = {value}",
          "original": "#{element} { right: {value}px; }"
        },

        "bottom": {
          "type": "style",
          "property": "bottom",
          "unit": "px",
          "webly": "{element}.bottom = {value}",
          "original": "#{element} { bottom: {value}px; }"
        },

        "opacity": {
          "type": "style",
          "property": "opacity",
          "webly": "{element}.opacity = {value}",
          "original": "#{element} { opacity: {value}; }"
        },

        "scale": {
          "type": "style",
          "property": "transform",
          "transform": "scale",
          "webly": "{element}.scale = {value}",
          "original": "#{element} { transform: scale({value}); }"
        },

        "hidden": {
          "type": "style",
          "property": "display",
          "hiddenValue": "none",
          "visibleValue": "",
          "webly": "{element}.hidden = {value}",
          "original": "#{element} { display: {value}; }"
        }
      }
    },

    "javascript": {
      "events": {
        "clicked": {
          "type": "event",
          "event": "click",
          "webly": "{element}.clicked { ... }",
          "original": "document.getElementById({element}).addEventListener(\"click\", async () => { ... });"
        },

        "hovered": {
          "type": "event",
          "event": "mouseenter",
          "webly": "{element}.hovered { ... }",
          "original": "document.getElementById({element}).addEventListener(\"mouseenter\", async () => { ... });"
        },

        "pressed": {
          "type": "event",
          "event": "mousedown",
          "webly": "{element}.pressed { ... }",
          "original": "document.getElementById({element}).addEventListener(\"mousedown\", async () => { ... });"
        },

        "released": {
          "type": "event",
          "event": "mouseup",
          "webly": "{element}.released { ... }",
          "original": "document.getElementById({element}).addEventListener(\"mouseup\", async () => { ... });"
        },

        "changed": {
          "type": "event",
          "event": "change",
          "webly": "{element}.changed { ... }",
          "original": "document.getElementById({element}).addEventListener(\"change\", async () => { ... });"
        },

        "focused": {
          "type": "event",
          "event": "focus",
          "webly": "{element}.focused { ... }",
          "original": "document.getElementById({element}).addEventListener(\"focus\", async () => { ... });"
        },

        "blurred": {
          "type": "event",
          "event": "blur",
          "webly": "{element}.blurred { ... }",
          "original": "document.getElementById({element}).addEventListener(\"blur\", async () => { ... });"
        }
      },

      "actions": {
        "hide": {
          "type": "action",
          "action": "style.display",
          "value": "none",
          "webly": "{element}.hide",
          "original": "document.getElementById({element}).style.display = \"none\";"
        },

        "show": {
          "type": "action",
          "action": "style.display",
          "value": "",
          "webly": "{element}.show",
          "original": "document.getElementById({element}).style.display = \"\";"
        },

        "disable": {
          "type": "action",
          "action": "disabled",
          "value": true,
          "webly": "{element}.disable",
          "original": "document.getElementById({element}).disabled = true;"
        },

        "enable": {
          "type": "action",
          "action": "disabled",
          "value": false,
          "webly": "{element}.enable",
          "original": "document.getElementById({element}).disabled = false;"
        },

        "focus": {
          "type": "action",
          "action": "focus",
          "webly": "{element}.focus",
          "original": "document.getElementById({element}).focus();"
        },

        "blur": {
          "type": "action",
          "action": "blur",
          "webly": "{element}.blur",
          "original": "document.getElementById({element}).blur();"
        }
      },

      "variables": {
        "assignment": {
          "type": "assignment",
          "operator": "=",
          "webly": "{name} = {value}",
          "original": "let {name} = {value};"
        },

        "addition": {
          "type": "assignment",
          "operator": "+=",
          "webly": "{name} += {value}",
          "original": "{name} += {value};"
        },

        "subtraction": {
          "type": "assignment",
          "operator": "-=",
          "webly": "{name} -= {value}",
          "original": "{name} -= {value};"
        },

        "multiplication": {
          "type": "assignment",
          "operator": "*=",
          "webly": "{name} *= {value}",
          "original": "{name} *= {value};"
        },

        "division": {
          "type": "assignment",
          "operator": "/=",
          "webly": "{name} /= {value}",
          "original": "{name} /= {value};"
        }
      },

      "functions": {
        "definition": {
          "type": "function",
          "webly": "function {name}() { ... }",
          "original": "function {name}() { ... }"
        },

        "call": {
          "type": "call",
          "webly": "{name}()",
          "original": "{name}();"
        }
      },

      "control": {
        "if": {
          "type": "control",
          "control": "if",
          "webly": "if {condition} { ... }",
          "original": "if ({condition}) { ... }"
        },

        "else": {
          "type": "control",
          "control": "else",
          "webly": "else { ... }",
          "original": "else { ... }"
        },

        "elseIf": {
          "type": "control",
          "control": "elseIf",
          "webly": "else if {condition} { ... }",
          "original": "else if ({condition}) { ... }"
        },

        "while": {
          "type": "control",
          "control": "while",
          "webly": "while {condition} { ... }",
          "original": "while ({condition}) { ... }"
        },

        "repeat": {
          "type": "control",
          "control": "repeat",
          "webly": "repeat {amount} { ... }",
          "original": "for (let i = 0; i < {amount}; i++) { ... }"
        },

        "forever": {
          "type": "control",
          "control": "forever",
          "webly": "repeat forever { ... }",
          "original": "while (true) { ... }"
        }
      },

      "timing": {
        "wait": {
          "type": "timing",
          "timing": "wait",
          "webly": "waity({seconds})",
          "original": "await new Promise(resolve => setTimeout(resolve, {milliseconds}));"
        },

        "timeout": {
          "type": "timing",
          "timing": "timeout",
          "webly": "after {seconds} { ... }",
          "original": "setTimeout(async () => { ... }, {milliseconds});"
        }
      }
    },

    "web": {
      "console": {
        "log": {
          "type": "native",
          "webly": "console.log({value})",
          "original": "console.log({value});"
        },

        "error": {
          "type": "native",
          "webly": "console.error({value})",
          "original": "console.error({value});"
        }
      },

      "navigation": {
        "go": {
          "type": "native",
          "webly": "page.go({url})",
          "original": "window.location.href = {url};"
        },

        "reload": {
          "type": "native",
          "webly": "page.reload",
          "original": "window.location.reload();"
        },

        "back": {
          "type": "native",
          "webly": "page.back",
          "original": "window.history.back();"
        }
      }
    }
  }
}