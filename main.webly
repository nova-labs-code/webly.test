wait = 1
function flash() {
    repeat forever {
        page.background = "red"
        wait(wait)

        page.background = "orange"
        wait(wait)

        page.background = "yellow"
        wait(wait)

        page.background = "green"
        wait(wait)

        page.background = "blue"
        wait(wait)

        page.background = "purple"
        wait(wait)
    }
}

flash()