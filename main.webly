wait = 1
function flash() {
    repeat forever {
        page.background = "red"
        waity(wait)

        page.background = "orange"
        waity(wait)

        page.background = "yellow"
        waity(wait)

        page.background = "green"
        waity(wait)

        page.background = "blue"
        waity(wait)

        page.background = "purple"
        waity(wait)
    }
}

flash()