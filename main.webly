function flash() {
    repeat forever {
        page.background = "red"
        wait(0.02)

        page.background = "orange"
        wait(0.02)

        page.background = "yellow"
        wait(0.02)

        page.background = "green"
        wait(0.02)

        page.background = "blue"
        wait(0.02)

        page.background = "purple"
        wait(0.02)
    }
}

flash()