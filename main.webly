button.create("colorButton")

colorButton.text = "FLASH"
colorButton.width = 200
colorButton.height = 60
colorButton.radius = 12
colorButton.fontSize = 20
colorButton.background = "#222233"
colorButton.color = "white"


function flash(button) {
    repeat forever {
        button.color = "red"
        wait(0.02)

        button.color = "orange"
        wait(0.02)

        button.color = "yellow"
        wait(0.02)

        button.color = "green"
        wait(0.02)

        button.color = "blue"
        wait(0.02)

        button.color = "purple"
        wait(0.02)
    }
}


flash(colorButton)